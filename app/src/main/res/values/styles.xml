<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0856CF</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorPrimaryContainer">#D9E2FF</item>
        <item name="colorOnPrimaryContainer">#00184A</item>

        <item name="colorSecondary">#585E71</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#DDE2FA</item>
        <item name="colorOnSecondaryContainer">#151B2C</item>

        <item name="colorTertiary">#735571</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FED7F9</item>
        <item name="colorOnTertiaryContainer">#2B122C</item>

        <item name="colorSurface">#FEFBFF</item>
        <item name="colorOnSurface">#1B1B1E</item>

        <item name="colorSurfaceVariant">#E2E2EC</item>
        <item name="colorOnSurfaceVariant">#44464E</item>
        <item name="colorOutline">#75767F</item>
        <item name="colorOutlineVariant">#C5C6D0</item>

        <item name="backgroundColor">#FEFBFF</item>
        <item name="colorOnBackground">#1B1B1E</item>

        <item name="colorPrimaryDark">#FEFBFF</item>
        <item name="colorContainer">#D9E2FF</item>
        <item name="colorAccent">#0856CF</item>
        <item name="chipSurfaceColor">#E2E2EC</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="actionMenuTextColor">@color/colorLightText</item>
        <item name="rippleColor">@color/colorLightRipple</item>
    </style>

    <style name="AppThemeDark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#b0c5ff</item>
        <item name="colorOnPrimary">#002B76</item>
        <item name="colorPrimaryContainer">#003FA4</item>
        <item name="colorOnPrimaryContainer">#D9E2FF</item>

        <item name="colorSecondary">#C0C6DD</item>
        <item name="colorOnSecondary">#2A3042</item>
        <item name="colorSecondaryContainer">#404659</item>
        <item name="colorOnSecondaryContainer">#DDE2FA</item>

        <item name="colorTertiary">#E1BBDD</item>
        <item name="colorOnTertiary">#422742</item>
        <item name="colorTertiaryContainer">#5A3D59</item>
        <item name="colorOnTertiaryContainer">#FED7F9</item>

        <item name="colorSurface">#1B1B1E</item>
        <item name="colorOnSurface">#E4E2E6</item>

        <item name="colorSurfaceVariant">#44464E</item>
        <item name="colorOnSurfaceVariant">#C5C6D0</item>
        <item name="colorOutline">#8F909A</item>
        <item name="colorOutlineVariant">#44464E</item>

        <item name="colorPrimaryDark">#1B1B1E</item>
        <item name="colorContainer">#B0C5FF</item>
        <item name="colorAccent">#0856CF</item>
        <item name="chipSurfaceColor">#1B1B1E</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="actionMenuTextColor">@color/colorDarkText</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="rippleColor">@color/colorDarkRipple</item>
    </style>

    <style name="ToggleStyle"></style>

    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:navigationBarColor">@color/colorLightPrimaryDark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dialog style for fullscreen result popup, transparent background -->
    <style name="AppTheme_Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="CategoryButtonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/toast_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="CategoryButtonText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle1</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="CategoryButtonIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_arrow</item>
        <item name="android:rotation">270</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="App.CustomActiveIndicator" parent="">
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.Science.Expressive.SectionCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Large</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Widget.Science.Expressive.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ShapeAppearance.Science.Expressive.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Science.Expressive.ExtraLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="MostUsedPill" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <declare-styleable name="ShadowView">
        <attr name="shadowDx" format="dimension" />
        <attr name="shadowDy" format="dimension" />
        <attr name="shadowRadius" format="dimension" />
        <attr name="shadowAlpha" format="integer" />
    </declare-styleable>

    <style name="IonDetailText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Science.Expressive.PropertyRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>


    <style name="ShapeAppearance.Science.BottomRounded" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="Widget.Science.Solubility.Cell" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_solubility_cell</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
