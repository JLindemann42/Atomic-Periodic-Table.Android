<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:elevation="32dp">

    <!-- This is the actual visible panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/panel_margin"
        android:background="@drawable/half_toast"
        android:backgroundTint="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/half_toast"
            android:backgroundTint="?attr/colorPrimary"
            android:alpha="0.11"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/drag_frame"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <TextView
                android:id="@+id/drag_icon"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="16dp"
                android:alpha="0.85"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorOnSecondaryContainer"
                android:elevation="4dp"
                android:gravity="center_horizontal" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/scroll_iso"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_marginTop="36dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/frame_iso"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp" />
        </ScrollView>

    </FrameLayout>

</FrameLayout>
