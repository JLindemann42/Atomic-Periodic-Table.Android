<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header_container"
        style="@style/Widget.Science.Expressive.SectionHeader">

        <ImageView
            android:id="@+id/overview_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_isotopes"
            app:tint="?attr/colorAccent" />

        <TextView
            android:id="@+id/overview_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/properties"
            android:textColor="?attr/colorAccent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Science.Expressive.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/atomic_number_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/atomic_number_label" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_atomic_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/atomic_weight_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/atomic_weight_relative_atomic_mass" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_atomic_weight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/density_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/density_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_density" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/electronegativity_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/electronegativity_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_electronegativty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/electronegativity_allen_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/electronegativity_allen_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_electronegativty_allen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/block_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/block_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_block" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/emission_spectrum_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/sp_lines_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/emission_spectrum_colon"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/sp_offline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/go_online_for_emission_lines"
                    android:textColor="?attr/colorError"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/sp_img"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/ic_launcher_background" />

                        <ImageView
                            android:id="@+id/open_btn2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="end|top"
                            android:layout_margin="8dp"
                            android:padding="6dp"
                            android:background="@drawable/cookie_7"
                            android:backgroundTint="?attr/colorSurface"
                            android:elevation="4dp"
                            app:srcCompat="@drawable/ic_open"
                            app:tint="?attr/colorPrimary"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/electron_view"
        style="@style/Widget.Science.Expressive.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/electron_text_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="140dp">

                <TextView
                    android:id="@+id/electron_shell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/electron_shell_colon"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/element_shells_electrons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="---"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/open_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|top"
                android:layout_margin="8dp"
                android:padding="6dp"
                android:background="@drawable/cookie_7"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="4dp"
                app:srcCompat="@drawable/ic_open"
                app:tint="?attr/colorSecondary"/>

            <ImageView
                android:id="@+id/model_view"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:scaleType="centerCrop"
                android:alpha="0.8"
                app:srcCompat="@drawable/ic_launcher_background" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
