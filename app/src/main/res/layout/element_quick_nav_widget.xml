<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows of two tiles, each row and each tile weighted so the grid always
     fills the whole widget box no matter what size the launcher hands us.
     (GridLayout row/column weights are not honoured reliably in RemoteViews.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Periodic Table -->
        <LinearLayout
            android:id="@+id/nav_table"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/widget_tile_gap"
            android:layout_marginBottom="@dimen/widget_tile_gap"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_nav_tile">

            <ImageView
                android:layout_width="@dimen/widget_tile_icon"
                android:layout_height="@dimen/widget_tile_icon"
                android:src="@drawable/ic_widget_grid"
                android:tint="@color/widget_on_secondary_container"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_nav_table"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_secondary_container"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Quiz -->
        <LinearLayout
            android:id="@+id/nav_quiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/widget_tile_gap"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_nav_tile">

            <ImageView
                android:layout_width="@dimen/widget_tile_icon"
                android:layout_height="@dimen/widget_tile_icon"
                android:src="@drawable/ic_widget_quiz"
                android:tint="@color/widget_on_secondary_container"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_nav_quiz"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_secondary_container"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- AI -->
        <LinearLayout
            android:id="@+id/nav_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/widget_tile_gap"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_nav_tile">

            <ImageView
                android:layout_width="@dimen/widget_tile_icon"
                android:layout_height="@dimen/widget_tile_icon"
                android:src="@drawable/ic_widget_ai"
                android:tint="@color/widget_on_secondary_container"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_nav_ai"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_secondary_container"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Molar Mass -->
        <LinearLayout
            android:id="@+id/nav_molar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/bg_nav_tile">

            <ImageView
                android:layout_width="@dimen/widget_tile_icon"
                android:layout_height="@dimen/widget_tile_icon"
                android:src="@drawable/ic_widget_calculator"
                android:tint="@color/widget_on_secondary_container"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_nav_molar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_secondary_container"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
