<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header_container"
        style="@style/Widget.Science.Expressive.SectionHeader">

        <ImageView
            android:id="@+id/overview_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/fav_electronegativity"
            app:tint="?attr/colorAccent" />

        <TextView
            android:id="@+id/overview_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/electromagnetic_properties"
            android:textColor="?attr/colorAccent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Science.Expressive.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/electrical_type_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/electrical_type_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_electrical_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/resistivity_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/electrical_resistivity_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_resistivity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/work_function_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/work_function_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_work_function" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/magnetic_type_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/magnetic_type_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_magnetic_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/curie_point_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/curie_point_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_curie_point" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/neel_point_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/neel_point_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_neel_point" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

            <LinearLayout
                android:id="@+id/superconducting_point_container"
                style="@style/Widget.Science.Expressive.PropertyRow">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/superconducting_point_colon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                <TextView android:id="@+id/element_superconducting_point" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
