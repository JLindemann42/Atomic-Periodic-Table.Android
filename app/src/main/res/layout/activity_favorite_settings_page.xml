<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ScrollView
        android:id="@+id/fav_set_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/favorite_set_title_downstate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="80dp"
                android:paddingBottom="12dp"
                android:text="@string/favorite_settings_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_general"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/molar_mass_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="true"
                            android:text="@string/show_molar_mass"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_weight_outline"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/phase_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="true"
                            android:text="@string/show_stp_phase"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/fav_gas"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/electronegativity_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="true"
                            android:text="@string/show_electronegativity"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/fav_electronegativity"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/density_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_density"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_weight_outline"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Temperature Settings -->
            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_temperatures"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/temp_unit_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kelvin_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/kelvin" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/celsius_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/celsius" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/fahrenheit_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/fahrenheit" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp">
                        <CheckBox
                            android:id="@+id/boiling_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/show_boiling_point"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_temperature"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/melting_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/show_melting_point"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_temperature"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Atomic Properties -->
            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_atomic_properties"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/atomic_radius_empirical_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/show_atomic_radius_empirical"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_radius"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/atomic_radius_calculated_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/show_atomic_radius_calculated"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_radius"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/covalent_radius_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/show_covalent_radius"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_radius"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/van_der_waals_radius_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:text="@string/show_van_der_waals_radius"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_radius"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Electromagnetic -->
            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_electromagnetic"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/resitivity_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_resistivity"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_heat"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thermodynamics -->
            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_thermodynamics"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/fusion_heat_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_fusion_heat"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_heat"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/specific_heat_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_specific_heat_capacity"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_heat"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/vaporization_heat_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_vaporization_heat"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_vaporization"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nuclear -->
            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_settings_nuclear"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.Material3.CompoundButton.CheckBox"
                            android:id="@+id/radioactive_check"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:checked="false"
                            android:text="@string/show_if_radioactive"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:layoutDirection="rtl"
                            android:drawableEnd="@drawable/ic_nucleari"
                            android:drawablePadding="12dp" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/unified_titlebar_include"
        layout="@layout/view_unified_titlebar"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
