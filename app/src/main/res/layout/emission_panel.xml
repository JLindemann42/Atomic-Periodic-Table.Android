<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:sothree="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="100dp">

    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:id="@+id/sliding_layout_e"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        sothree:umanoFadeColor="@android:color/transparent"
        sothree:umanoInitialState="collapsed"
        sothree:umanoPanelHeight="0dp"
        sothree:umanoShadowHeight="0dp">

        <!-- Background content (main activity content) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Sliding Panel content -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/drag_handle"
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/toast"
                    android:backgroundTint="?attr/colorOutlineVariant"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ScrollView
                    android:id="@+id/scroll_emi_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/drag_handle"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/emi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="Element"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                            <ImageView
                                android:id="@+id/emi_img_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                app:srcCompat="@drawable/ic_launcher_background" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Scales -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="40dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="400" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="24dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="40dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="24dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="40dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="600" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="24dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                <View android:layout_width="2dp" android:layout_height="40dp" android:background="?attr/colorOnSurface" android:alpha="0.2" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="700" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceVariant"
                            app:strokeWidth="0dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wavelength range: 380-720 nm" android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Wavelength in: vacuum" android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </ScrollView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.sothree.slidinguppanel.SlidingUpPanelLayout>
</FrameLayout>
