<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pro_hazard_box"
        style="@style/Widget.Science.Expressive.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_lock"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hazard_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hazard_title_requires_pro"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/get_pro_hazard_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/get_pro_title"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/hazard_properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_container"
            style="@style/Widget.Science.Expressive.SectionHeader">

            <ImageView
                android:id="@+id/overview_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_hazard"
                app:tint="?attr/colorAccent" />

            <TextView
                android:id="@+id/overview_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/hazard_title"
                android:textColor="?attr/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Science.Expressive.SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/hazard_content_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/hazard_data_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/fire_hazard_container"
                        style="@style/Widget.Science.Expressive.PropertyRow"
                        android:paddingVertical="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fire_hazard" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                            <TextView android:id="@+id/fire_hazard_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

                    <LinearLayout
                        android:id="@+id/health_hazard_container"
                        style="@style/Widget.Science.Expressive.PropertyRow"
                        android:paddingVertical="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/health_hazard" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                            <TextView android:id="@+id/health_hazard_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

                    <LinearLayout
                        android:id="@+id/reactivity_hazard_container"
                        style="@style/Widget.Science.Expressive.PropertyRow"
                        android:paddingVertical="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reactivity_hazard" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                            <TextView android:id="@+id/reactivity_hazard_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:alpha="0.1" />

                    <LinearLayout
                        android:id="@+id/specific_hazard_container"
                        style="@style/Widget.Science.Expressive.PropertyRow"
                        android:paddingVertical="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/specific_hazard" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                            <TextView android:id="@+id/specific_hazard_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="---" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hazard_visualization_container"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:rotation="45">

                        <FrameLayout
                            android:id="@+id/fire_hazard_box"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/cookie_7"
                            android:backgroundTint="?attr/colorError">
                            <TextView
                                android:id="@+id/fire_hazard_txt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:rotation="-45"
                                android:text="-"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/reactivity_hazard_box"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="42dp"
                            android:background="@drawable/cookie_7"
                            android:backgroundTint="?attr/colorTertiary">
                            <TextView
                                android:id="@+id/reactivity_hazard_txt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:rotation="-45"
                                android:text="-"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/health_hazard_box"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginTop="42dp"
                            android:background="@drawable/cookie_7"
                            android:backgroundTint="?attr/colorPrimary">
                            <TextView
                                android:id="@+id/health_hazard_txt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:rotation="-45"
                                android:text="-"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="42dp"
                            android:layout_marginTop="42dp"
                            android:background="@drawable/cookie_7"
                            android:backgroundTint="?attr/colorSurfaceVariant">
                            <TextView
                                android:id="@+id/specific_hazard_txt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:rotation="-45"
                                android:text="-"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
