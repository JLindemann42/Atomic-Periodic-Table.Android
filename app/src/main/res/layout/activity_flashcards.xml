<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/view_flash"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fragment_rounded"
    android:clipToOutline="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/flashcard_scroll"
        android:layout_width="match_parent"
        android:layout_marginTop="56dp"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/flashcard_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/level_stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:text="@string/level_stat_placeholder"
                            android:layout_gravity="center_horizontal"
                            android:textColor="?attr/colorOnSurface"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="@string/flashcards_level"
                            android:textAlignment="center"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center_horizontal"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/completed_quizzes_stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:text="@string/completed_quizzes_stat_placeholder"
                            android:layout_gravity="center_horizontal"
                            android:textColor="?attr/colorOnSurface"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="@string/flashcards_total_games"
                            android:textAlignment="center"
                            android:layout_gravity="center_horizontal"
                            android:textColor="?attr/colorOnSurface"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                    <ImageButton
                        android:id="@+id/shuffle_btn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:rotation="180"
                        app:tint="?attr/colorOnSecondaryContainer"
                        android:src="@drawable/ic_random_large"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stats_Box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flashcards_statistics"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="?attr/colorPrimary"
                        android:drawableStart="@drawable/ic_stats"
                        android:drawablePadding="8dp"
                        app:drawableTint="?attr/colorPrimary"
                        android:layout_marginTop="@dimen/default_padding"
                        android:layout_marginStart="@dimen/default_padding"
                        android:layout_marginEnd="@dimen/default_padding"
                        android:layout_marginBottom="@dimen/margin_space_card"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/xp_progress"
                            android:layout_width="0dp"
                            android:layout_height="12dp"
                            android:layout_weight="1"
                            app:trackThickness="12dp"
                            app:trackCornerRadius="6dp"
                            android:max="100"
                            android:progress="50"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_text_placeholder"
                            android:textSize="14sp"
                            android:gravity="end"
                            android:alpha="0.95"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginEnd="18dp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/total_xp_stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:text="@string/total_xp_placeholder"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurface"/>

                    <TextView
                        android:id="@+id/xp_bonus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:text="@string/bonus_xp"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="4dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurface"/>

                    <TextView
                        android:id="@+id/sync_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:text="@string/sync_status"
                        android:visibility="gone"
                        android:textStyle="italic"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="16dp"
                        android:textColor="?attr/colorOnSurface"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/enable_sync_login"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_marginBottom="8dp"
                        android:layout_gravity="end"
                        android:text="@string/login_for_sync"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pro_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="visible"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin"
                            android:clickable="true"
                            android:drawableStart="@drawable/ic_star"
                            android:drawablePadding="12dp"
                            app:drawableTint="?attr/colorPrimary"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:text="@string/unlock_all_flashcards"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:paddingStart="@dimen/margin"
                            android:paddingEnd="@dimen/margin"
                            android:paddingBottom="8dp"
                            android:paddingTop="2dp"
                            android:text="@string/upgrade_pro_plus_description"/>

                        <TextView
                            android:id="@+id/sync_desc_title"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin"
                            android:clickable="true"
                            android:drawableStart="@drawable/ic_cloud_sync"
                            android:drawablePadding="12dp"
                            app:drawableTint="?attr/colorPrimary"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:text="@string/enable_sync"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/sync_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:paddingStart="@dimen/margin"
                            android:paddingEnd="@dimen/margin"
                            android:paddingBottom="8dp"
                            android:paddingTop="2dp"
                            android:text="@string/enable_sync_desc"/>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/get_pro_plus_btn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="end"
                        android:text="@string/upgrade_to_pro_plus"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/difficulty_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flashcards_difficulty_title"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="?attr/colorPrimary"
                        android:drawableStart="@drawable/ic_flashcards"
                        android:drawablePadding="8dp"
                        app:drawableTint="?attr/colorPrimary"
                        android:layout_marginBottom="@dimen/margin_space_card"/>

                    <TextView
                        android:id="@+id/tv_category_select_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="@string/flashcards_difficulty"
                        android:textAppearance="?attr/textAppearanceHeadline5"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/difficulty_toggle_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/toggle_easy">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggle_easy"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/easy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggle_medium"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggle_hard"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hard" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_lives_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/colorError"
                android:textSize="16sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>
            <!-- Boxes container: we will inflate level_box.xml into this container at runtime -->
            <LinearLayout
                android:id="@+id/boxes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/common_title_back_fla"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="1dp"
        android:background="?attr/colorSurface"
        android:gravity="center|center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/title_box"
                android:layout_width="match_parent"
                android:layout_height="56dp">


                <TextView
                    android:id="@+id/flashcard_title"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="16dp"
                    android:alpha="0.9"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/flashcards_title"
                    android:drawableStart="@drawable/ic_flashcards"
                    android:drawablePadding="8dp"
                    android:drawableTint="?attr/colorOnSecondaryContainer"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/tools_layout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical|end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/history_btn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:visibility="gone"
                        android:layout_gravity="center_vertical"
                        android:rotation="180"
                        app:tint="?attr/colorOnSecondaryContainer"
                        android:src="@drawable/ic_history" />

                    <ImageButton
                        android:id="@+id/achievements_btn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:visibility="visible"
                        android:background="@drawable/gem"
                        android:backgroundTint="?attr/colorAccent"
                        android:layout_gravity="center_vertical"
                        app:tint="?attr/colorOnPrimary"
                        android:src="@drawable/ic_achievements" />


                    <TextView
                        android:id="@+id/tv_lives_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lives_count_placeholder"
                        android:textSize="20sp"
                        android:drawableStart="@drawable/ic_heart"
                        android:drawableTint="?attr/colorError"
                        android:paddingEnd="16dp"
                        android:drawablePadding="4dp"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>


            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>