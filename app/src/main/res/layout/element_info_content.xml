<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <Space
        android:id="@+id/offline_space"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <FrameLayout
        android:id="@+id/main_content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <include
                android:id="@+id/ldn_place"
                layout="@layout/loading_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center_horizontal|center_vertical" />

            <ImageView
                android:id="@+id/element_image"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:adjustViewBounds="true"
                android:elevation="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />

            <ImageButton
                android:id="@+id/previous_btn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:elevation="4dp"
                android:rotation="180"
                app:tint="?attr/colorAccent"
                android:visibility="visible"
                android:background="@drawable/square_button"
                app:backgroundTint="?attr/colorSurface"
                android:foreground="@drawable/square_button_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_arrow_back_whit" />

            <ImageButton
                android:id="@+id/next_btn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginBottom="24dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:elevation="4dp"
                app:tint="?attr/colorPrimary"
                android:visibility="visible"
                android:background="@drawable/square_button"
                app:backgroundTint="?attr/colorSurface"
                android:foreground="@drawable/square_button_ripple"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_arrow_back_whit" />
        </FrameLayout>

        <Space
            android:id="@+id/offline_div"
            android:layout_width="wrap_content"
            android:layout_height="110dp"
            android:visibility="gone" />

        <include
            android:id="@+id/favorite_bar"
            layout="@layout/favorite_bar"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

    <include
        android:id="@+id/overview_inc"
        layout="@layout/d_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/properties_inc"
        layout="@layout/d_properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/temperatures_inc"
        layout="@layout/d_temperatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/atomic_inc"
        layout="@layout/d_atomic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/electromagnetic_inc"
        layout="@layout/d_electromagnetic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/addition_physics"
        layout="@layout/d_thermodynamic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/nuclear_inc"
        layout="@layout/d_nuclear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/hardness_inc"
        layout="@layout/d_hardness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/more_inc"
        layout="@layout/d_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/abundance_inc"
        layout="@layout/d_abundance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/grid_inc"
        layout="@layout/d_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/hazards_inc"
        layout="@layout/d_hazards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/other_inc"
        layout="@layout/d_other"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/i_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/square_button"
        android:backgroundTint="?attr/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/square_button_ripple"
        android:text="@string/submit_data_issue"
        android:textColor="?attr/colorOnPrimary" />

    <Space
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

</LinearLayout>
