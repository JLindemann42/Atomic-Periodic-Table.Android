<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Space
        android:id="@+id/offline_space"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <FrameLayout
        android:id="@+id/main_content_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_margin="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.ExtraLarge">

            <ImageView
                android:id="@+id/element_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000" />

            <!-- Above the image so the spinner and the "No Image" fallback stay visible -->
            <include
                android:id="@+id/ldn_place"
                layout="@layout/loading_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previous_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:padding="0dp"
                android:rotation="180"
                app:icon="@drawable/ic_arrow_back_whit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:padding="0dp"
                app:icon="@drawable/ic_arrow_back_whit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:id="@+id/offline_div"
            android:layout_width="wrap_content"
            android:layout_height="110dp"
            android:visibility="gone" />

        <include
            android:id="@+id/favorite_bar"
            layout="@layout/favorite_bar"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp" />

    </FrameLayout>

    <include
        android:id="@+id/overview_inc"
        layout="@layout/d_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/properties_inc"
        layout="@layout/d_properties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/temperatures_inc"
        layout="@layout/d_temperatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/atomic_inc"
        layout="@layout/d_atomic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/electromagnetic_inc"
        layout="@layout/d_electromagnetic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/addition_physics"
        layout="@layout/d_thermodynamic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/nuclear_inc"
        layout="@layout/d_nuclear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/hardness_inc"
        layout="@layout/d_hardness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/more_inc"
        layout="@layout/d_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/abundance_inc"
        layout="@layout/d_abundance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/grid_inc"
        layout="@layout/d_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/hazards_inc"
        layout="@layout/d_hazards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/other_inc"
        layout="@layout/d_other"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/i_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:text="@string/submit_data_issue"
        app:icon="@drawable/ic_bug"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

    <Space
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

</LinearLayout>
