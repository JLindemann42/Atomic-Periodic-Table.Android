<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:elevation="32dp">

    <!-- This is the actual visible panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/panel_margin"
        android:background="@drawable/half_toast"
        android:backgroundTint="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/drag_frame_poisson"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="16dp"
                android:alpha="0.85"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorOnSecondaryContainer"
                android:elevation="4dp"
                android:gravity="center_horizontal" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/scroll_poisson"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_marginTop="36dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="48dp">

        <TextView
                    android:id="@+id/detail_poisson_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Element Name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rs_poisson_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="12dp"
                    android:enabled="false"
                    android:valueFrom="0.0"
                    android:valueTo="0.5"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:thumbRadius="0dp"
                    app:thumbElevation="0dp"
                    app:trackHeight="12dp"
                    app:trackColorInactive="?attr/colorSurfaceVariant"
                    app:trackColorActive="?attr/colorPrimary"
                    app:values="@array/poisson_default_values" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.0"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.1"
                        android:gravity="center"
                        android:textAlignment="viewEnd"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.2"
                        android:gravity="center"
                        android:textAlignment="viewEnd"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.3"
                        android:gravity="center"
                        android:textAlignment="viewEnd"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.4"
                        android:gravity="center"
                        android:textAlignment="viewEnd"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.5"
                        android:gravity="center"
                        android:textAlignment="viewEnd"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Poisson's ratio is a measure of the Poisson effect, the phenomenon in which a material tends to expand in directions perpendicular to the direction of compression."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:alpha="0.7" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</FrameLayout>
