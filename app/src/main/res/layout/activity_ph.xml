<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_ph"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ScrollView
        android:id="@+id/ph_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/ph_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ph_title_downstate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="80dp"
                android:paddingBottom="24dp"
                android:text="@string/activity_ph_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp">
                        <ImageView android:id="@+id/left" android:layout_width="match_parent" android:layout_height="match_parent" app:tint="#E91E63" app:srcCompat="@drawable/ph_edge" />
                        <ImageView android:id="@+id/center" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.5" app:tint="#FF5722" app:srcCompat="@drawable/ph_center" />
                        <ImageView android:id="@+id/right" android:layout_width="match_parent" android:layout_height="match_parent" android:rotation="180" app:tint="@color/alkaline" app:srcCompat="@drawable/ph_edge" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/acid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_acid" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:id="@+id/acid_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_acid" android:textAlignment="center" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:alpha="0.8" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/neutral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_neutral" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:id="@+id/neutral_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_neutral" android:textAlignment="center" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:alpha="0.8" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/alkaline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_alkaline" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:id="@+id/alkaline_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_ph_alkaline" android:textAlignment="center" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:alpha="0.8" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/ph_chip_bar"
                layout="@layout/bar_ph_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/unified_titlebar_include"
        layout="@layout/view_unified_titlebar"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
