<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_ideal_gas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ScrollView
        android:id="@+id/ideal_gas_calculator_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/ideal_gas_calculator_title_downstate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="80dp"
                android:paddingBottom="24dp"
                android:text="@string/ideal_gas_calculator_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ideal_gas_box"
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ideal_gas_calculate_field"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium"
                        android:layout_marginBottom="24dp">
                        <Spinner
                            android:id="@+id/calculate_field_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="12dp"
                            android:background="@android:color/transparent" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Input Area -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/toast"
                        android:backgroundTint="?attr/colorSurface"
                        android:padding="16dp">

                        <!-- Pressure Input -->
                        <LinearLayout
                            android:id="@+id/pressure_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="false">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/pressure_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/ideal_gas_pressure"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:padding="0dp"
                                    android:background="@android:color/transparent"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Spinner
                                android:id="@+id/pressure_unit_spinner"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:alpha="0.2"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/colorOnSurface"/>

                        <!-- Volume Input -->
                        <LinearLayout
                            android:id="@+id/volume_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="false">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/volume_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/ideal_gas_volume"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"

                                    android:inputType="numberDecimal|numberSigned"
                                    android:padding="0dp"
                                    android:background="@android:color/transparent"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Spinner
                                android:id="@+id/volume_unit_spinner"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:alpha="0.2"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/colorOnSurface"/>

                        <!-- Moles Input -->
                        <LinearLayout
                            android:id="@+id/moles_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="false">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/moles_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/ideal_gas_moles"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:padding="0dp"
                                    android:background="@android:color/transparent"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mol"
                                android:textSize="14sp"
                                android:layout_marginEnd="12dp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:alpha="0.2"
                            android:layout_marginVertical="12dp"
                            android:background="?attr/colorOnSurface"/>

                        <!-- Temperature Input -->
                        <LinearLayout
                            android:id="@+id/temperature_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="false">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/temperature_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/ideal_gas_temperature"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:padding="0dp"
                                    android:background="@android:color/transparent"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Spinner
                                android:id="@+id/temperature_unit_spinner"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Result Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="24dp"
                        android:padding="16dp"
                        android:background="@drawable/toast"
                        android:backgroundTint="?attr/colorPrimaryContainer">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ideal_gas_result"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/out_text_ideal_gas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/calculator_default_value"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fav_star_btn_ideal_gas"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:text="@string/unit_add_favorite"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        app:icon="@drawable/ic_star"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Favorites -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fav_box_ideal_gas"
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_favorites"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/no_pro_text_ideal_gas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:visibility="visible"
                        android:text="@string/calc_no_pro_text"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pro_button_ideal_gas"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/get_pro_title"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

                    <TextView
                        android:id="@+id/no_fav_text_ideal_gas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:visibility="gone"
                        android:text="@string/calc_no_favorites"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fav_rec_list_ideal_gas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/unified_titlebar_include"
        layout="@layout/view_unified_titlebar"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
