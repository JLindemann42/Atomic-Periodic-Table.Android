<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin"
    android:layout_marginTop="@dimen/margin_space_card"
    android:layout_marginEnd="@dimen/margin"
    android:layout_marginBottom="@dimen/margin_space_card"
    android:background="@drawable/toast_card"
    android:backgroundTint="?attr/colorSurfaceVariant"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:foreground="@drawable/toast_card_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/table_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginEnd="@dimen/margin_space"
                android:layout_marginBottom="@dimen/margin_space"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="24sp"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/drag_handle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/margin"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:src="@drawable/ic_drag"
                android:tint="?attr/colorOnSurfaceVariant"
                android:alpha="0.6"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/space_drag"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>

        <TextView
            android:id="@+id/pro_badge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="start"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="@dimen/margin_space"
            android:layout_marginEnd="@dimen/margin"
            android:layout_marginBottom="@dimen/margin_space"
            android:alpha="0.8"
            android:background="@drawable/toast"
            android:backgroundTint="?attr/colorTertiary"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/requires_pro"
            android:textAlignment="center"
            android:textColor="?attr/colorOnTertiary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/table_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="@dimen/margin_space"
            android:layout_marginEnd="@dimen/margin"
            android:layout_marginBottom="@dimen/margin_space"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/table_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/margin_space"
            android:layout_marginEnd="@dimen/margin"
            android:background="@drawable/toast"
            android:backgroundTint="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/toast_ripple"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/open_table_button"
            android:textAlignment="center"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
