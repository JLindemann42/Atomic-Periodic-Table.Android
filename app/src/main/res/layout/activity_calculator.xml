<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_cal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">


    <ScrollView
        android:id="@+id/calculator_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/calculator_title_downstate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="80dp"
                android:paddingBottom="24dp"
                android:text="@string/calculator_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cal_box"
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calculator_card_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/formula_input_layout"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/fav_star_btn"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_cal"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:hint="@string/calculator_formula"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="20sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/fav_star_btn"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:icon="@drawable/ic_star_xl"
                            app:cornerRadius="16dp"
                            app:iconSize="34dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="@+id/formula_input_layout" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/calc_molar_mass"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/out_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/calculator_default_value"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_weight_outline"
                        android:drawablePadding="4dp"
                        app:drawableTint="?attr/colorTertiary"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/hint_calc_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:visibility="gone"
                        android:text="@string/calc_elements_shown"
                        android:layout_marginTop="16dp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/inc_weight_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fav_box"
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="@string/calc_favorites"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/no_pro_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:visibility="visible"
                        android:text="@string/calc_no_pro_text"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/no_fav_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:visibility="gone"
                        android:text="@string/calc_no_favorites"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pro_button_cal"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/get_pro_title"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fav_rec_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/unified_titlebar_include"
        layout="@layout/view_unified_titlebar"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
