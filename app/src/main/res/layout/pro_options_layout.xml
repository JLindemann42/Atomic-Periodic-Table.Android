<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pro_bg"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_core_features"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/pro_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pro_version"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:id="@+id/pro_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_advanced_data_and_extra_atomic_content"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <TextView
                android:id="@+id/pro_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorPrimary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pro_buy_btn"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/get_pro"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pro_plus_bg"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/pro_plus_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/most_advanced"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorAccent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/pro_plus_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pro_plus_version"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="?attr/colorOnPrimaryContainer"/>

            <TextView
                android:id="@+id/pro_plus_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_advanced_data_and_additional_flashcards"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:alpha="0.8"/>

            <TextView
                android:id="@+id/pro_plus_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorPrimary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pro_plus_buy_btn"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/get_pro_plus_button"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
