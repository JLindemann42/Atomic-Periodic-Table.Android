<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:elevation="32dp">

    <!-- This is the actual visible panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/panel_margin"
        android:background="@drawable/half_toast"
        android:backgroundTint="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/drag_frame_alloy"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="16dp"
                android:alpha="0.85"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorOnSecondaryContainer"
                android:elevation="4dp"
                android:gravity="center_horizontal" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/scroll_alloy"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_marginTop="36dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="48dp">

                <TextView
                    android:id="@+id/alloy_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alloy Name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <TextView android:id="@+id/alloy_base" style="@style/IonDetailText" />
                <TextView android:id="@+id/alloy_composition" style="@style/IonDetailText" />
                <TextView android:id="@+id/alloy_description" style="@style/IonDetailText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alloy_base_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/open_base_element"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</FrameLayout>
