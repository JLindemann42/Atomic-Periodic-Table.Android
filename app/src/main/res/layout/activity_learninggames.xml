<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_learn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <com.jlindemann.science.views.ScienceBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:id="@+id/quiz_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/quiz_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/8"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <ProgressBar
                android:id="@+id/time_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="100"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:id="@+id/grid_answers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_gravity="center">

                <!-- ANSWER CARD 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/answer_1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium">
                    <TextView
                        android:id="@+id/answer_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Option 1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:padding="8dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- ANSWER CARD 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/answer_2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium">
                    <TextView
                        android:id="@+id/answer_text_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Option 2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:padding="8dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- ANSWER CARD 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/answer_3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium">
                    <TextView
                        android:id="@+id/answer_text_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Option 3"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:padding="8dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- ANSWER CARD 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/answer_4"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Science.Expressive.Medium">
                    <TextView
                        android:id="@+id/answer_text_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Option 4"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:padding="8dp"/>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <TextView
                android:id="@+id/tv_lives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lives: 5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="invisible"
                android:textColor="?attr/colorError"
                android:layout_marginTop="24dp"
                android:layout_gravity="center"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/common_title_back_learn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:background="?attr/backgroundColor"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/common_title_back_learn_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:visibility="invisible">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorPrimary"
                android:alpha="0.11" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_box"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_btn_learn"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:rotation="180"
                app:icon="@drawable/ic_arrow_back_whit"
                app:iconTint="?attr/colorOnSecondaryContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/learn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/flashcards_title"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/back_btn_learn" />

            <TextView
                android:id="@+id/tv_lives_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_heart"
                app:drawableTint="?attr/colorError"
                android:drawablePadding="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/effect_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/result_card_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/toast_card"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/result_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:text="Correct"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="?attr/colorAccent"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
