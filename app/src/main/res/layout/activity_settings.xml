<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <ScrollView
        android:id="@+id/scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/element_title_downstate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="80dp"
                android:text="@string/settings"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/toast_card_outline"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/instagram_btn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:icon="@drawable/ic_instagram_outline"
                        app:iconSize="24dp"
                        app:iconTint="?attr/actionMenuTextColor" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/facebook_btn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:icon="@drawable/ic_facebook_outline"
                        app:iconSize="24dp"
                        app:iconTint="?attr/actionMenuTextColor" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bluesky_btn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:icon="@drawable/ic_bluesky"
                        app:iconSize="24dp"
                        app:iconTint="?attr/actionMenuTextColor" />
                </LinearLayout>
                <Button
                    android:id="@+id/blog_btn"
                    android:layout_width="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:layout_height="42dp"
                    android:layout_gravity="end"
                    style="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox"
                    android:text="@string/blog"/>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/personalization_box"
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:id="@+id/personalization_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personalization_settings"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Themes -->
                    <LinearLayout
                        android:id="@+id/themes_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:srcCompat="@drawable/ic_themes"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/themes" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/select_theme" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Favorites -->
                    <LinearLayout
                        android:id="@+id/favorite_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_star" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/favorite_bar" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/personalise_favorite_bar" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Order Settings (Dynamic) -->
                    <LinearLayout
                        android:id="@+id/order_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_alphab" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/detail_card_order" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/customize_detail_card_order" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:id="@+id/order_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" android:visibility="gone" />

                    <!-- Units -->
                    <LinearLayout
                        android:id="@+id/unit_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_unit" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/table_units" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/customize_units_table" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Language -->
                    <LinearLayout
                        android:id="@+id/language_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_language" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/language_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:id="@+id/language_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/language_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/advanced_box"
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data &amp; Behavior"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Offline Mode -->
                    <LinearLayout
                        android:id="@+id/offline_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_data" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline_mode" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline_mode_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch                            android:id="@+id/offline_internet_switch"
                            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Bottom Bar (Nav Bar Settings) -->
                    <LinearLayout
                        android:id="@+id/nav_bar_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_visibility" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_hide_bottombar" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_hide_bottombar_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nav_bar_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:id="@+id/nav_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" android:visibility="gone" />

                    <!-- Analytics -->
                    <LinearLayout
                        android:id="@+id/analytics_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_stats" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/analytics_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/analytics_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/analytics_switch"
                            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Clear Cache -->
                    <LinearLayout
                        android:id="@+id/cache_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_close" app:tint="?attr/colorError" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_cache_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:id="@+id/clear_cache_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_cache_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                style="@style/Widget.Science.Expressive.SectionHeader">
                <TextView
                    android:id="@+id/other_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_settings"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Science.Expressive.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="120dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Submit Data Issue -->
                    <LinearLayout
                        android:id="@+id/submit_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_bug" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/submit_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/submit_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Licenses -->
                    <LinearLayout
                        android:id="@+id/licenses_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/overview_icon" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/licenses_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/licenses_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Credits -->
                    <LinearLayout
                        android:id="@+id/credits_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_credits" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/credits_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/credits_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- About -->
                    <LinearLayout
                        android:id="@+id/about_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_info" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/info_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/info_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- GitHub -->
                    <LinearLayout
                        android:id="@+id/git_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_github" app:tint="?attr/colorOnSurface" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/git_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/git_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_open" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Windows -->
                    <LinearLayout
                        android:id="@+id/win_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_windows" app:tint="?attr/colorPrimary" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/win_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/win_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_open" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="56dp" android:background="?attr/colorOutlineVariant" android:alpha="0.2" />

                    <!-- Experimental (Dynamic) -->
                    <LinearLayout
                        android:id="@+id/experimental_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" app:srcCompat="@drawable/ic_experimental" app:tint="?attr/colorAccent" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/experimental_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/experimental_text" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_arrow" android:rotation="270" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/unified_titlebar_include"
        layout="@layout/view_unified_titlebar"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/theme_panel"
        layout="@layout/theme_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:elevation="100dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
