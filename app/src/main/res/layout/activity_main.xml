        </com.otaliastudios.zoom.ZoomLayout>
    </FrameLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/more_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:backgroundTint="?attr/colorPrimary"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:src="@drawable/ic_filter"
        android:tint="?attr/colorOnPrimary"
        app:borderWidth="0dp"
        app:elevation="14dp"
        app:layout_constraintBottom_toBottomOf="@id/nav_bar_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/nav_bar_main"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:alpha="1"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:elevation="13dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.08"
            android:background="?attr/colorPrimary"
            android:elevation="9dp" />

        <FrameLayout
            android:id="@+id/nav_content"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="top"
            android:fitsSystemWindows="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settings_btn"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_settings"
                android:foreground="@drawable/c_ripple"
                app:tint="?attr/colorOnSecondaryContainer"
                app:backgroundTint="@color/transparent"
                app:borderWidth="0dp"
                app:elevation="0dp" />

            <ImageButton
                android:id="@+id/menu_btn"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_gravity="start"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/c_ripple"
                android:src="@drawable/ic_menu"
                app:tint="?attr/colorOnSecondaryContainer"
                app:backgroundTint="@color/transparent"
                app:borderWidth="0dp"
                app:elevation="0dp" />
        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/nav_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:background="@color/colorLightText"
        android:elevation="14dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hover_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:background="@color/colorLightText"
        android:elevation="14dp"
        android:visibility="gone" />

    <include
        android:id="@+id/nav_menu_include"
        layout="@layout/nav_menu_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="100dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/hover_menu_include"
        layout="@layout/hover_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="36dp"
