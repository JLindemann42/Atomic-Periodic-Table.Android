<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/alphabet_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:drawableStart="@drawable/ic_alphab"
            android:drawablePadding="12dp"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/alphabetical"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/elmt_numb_btn2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:drawableStart="@drawable/overview_icon"
            android:drawablePadding="12dp"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/element_number"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/electro_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:drawableStart="@drawable/fav_electronegativity"
            android:drawablePadding="12dp"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Electronegativity"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
