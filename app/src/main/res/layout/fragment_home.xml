<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fragment_rounded"
    android:clipToOutline="true">

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/ai_chat_fab"
        app:materialThemeOverlay="@style/ThemeOverlay.Material3Expressive.FloatingActionButton.Primary"        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="@string/ask_atomic"
        android:textAllCaps="false"
        app:icon="@drawable/ic_ai_mascot"
        app:iconPadding="8dp"
        app:iconSize="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/filterFab"
        app:materialThemeOverlay="@style/ThemeOverlay.Material3Expressive.FloatingActionButton.Tertiary"
        android:contentDescription="@string/filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_filter"
        android:layout_marginBottom="82dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Periodic Table Bars and ZoomLayout -->
    <FrameLayout
        android:id="@+id/periodic_table_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <HorizontalScrollView
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="0dp"
            android:clickable="false"
            android:fadeScrollbars="true"
            android:requiresFadingEdge="horizontal"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="72dp"
            android:focusable="false"
            android:scrollIndicators="none"
            android:scrollbarFadeDuration="24"
            android:scrollbarThumbHorizontal="@color/transparent"
            android:scrollbarThumbVertical="@color/transparent">

            <LinearLayout
                android:id="@+id/topLin"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <!-- Group numbers -->
                <TextView android:id="@+id/top_number" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="1" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number2" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="2" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number3" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="3" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number4" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="4" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number5" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="5" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number6" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="6" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number7" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="7" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number8" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="8" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number9" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="9" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number10" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="10" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number11" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="11" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number12" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="12" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number13" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="13" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number14" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="14" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number15" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="15" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number16" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="16" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number17" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="17" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/top_number18" android:layout_width="96dp" android:layout_height="match_parent" android:layout_weight="1" android:elevation="24dp" android:gravity="center" android:text="18" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/leftBar"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginTop="32dp"
            android:background="?attr/colorSurface"
            android:clickable="true"
            android:requiresFadingEdge="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="48dp"
            android:focusable="false"
            android:scrollIndicators="none"
            android:scrollbarFadeDuration="24"
            android:scrollbarThumbHorizontal="@color/transparent"
            android:scrollbarThumbVertical="@color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/list_numbers" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="1" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="2" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers3" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="3" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers4" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="4" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers5" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="5" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers6" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="6" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers7" android:layout_width="32dp" android:layout_height="96dp" android:layout_gravity="end" android:elevation="24dp" android:gravity="center" android:text="7" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
                <TextView android:id="@+id/list_numbers8" android:layout_width="match_parent" android:layout_height="600dp" android:elevation="24dp" android:gravity="center" android:textColor="?attr/actionMenuTextColor" android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <com.otaliastudios.zoom.ZoomLayout
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:clickable="false"
            android:elevation="-1dp"
            android:focusable="true"
            android:scrollbars="vertical|horizontal"
            android:visibility="visible"
            app:alignment="top|left"
            app:animationDuration="200"
            app:flingEnabled="true"
            app:hasClickableChildren="true"
            app:horizontalPanEnabled="true"
            app:maxZoom="1"
            app:maxZoomType="zoom"
            app:minZoom="0.25"
            app:minZoomType="zoom"
            app:oneFingerScrollEnabled="true"
            app:overPinchable="true"
            app:overScrollHorizontal="false"
            app:overScrollVertical="false"
            app:scrollEnabled="true"
            app:threeFingersScrollEnabled="true"
            app:transformation="none"
            app:transformationGravity="auto"
            app:twoFingersScrollEnabled="true"
            app:verticalPanEnabled="true"
            app:zoomEnabled="true">

            <LinearLayout
                android:id="@+id/scrollLin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="320dp">

                <LinearLayout android:id="@+id/one" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="32dp" android:orientation="vertical">
                    <include layout="@layout/group_1" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_2" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_3" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_4" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_5" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_6" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_7" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_8" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_9" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_10" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_11" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_12" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_13" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_14" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_15" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_16" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_17" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <include layout="@layout/group_18" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="9dp" />
                </LinearLayout>
            </LinearLayout>
        </com.otaliastudios.zoom.ZoomLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
