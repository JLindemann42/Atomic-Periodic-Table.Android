<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_science_daily_widget"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/science_daily_title"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="@color/widget_on_tertiary_container"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:alpha="0.7"
        android:layout_marginBottom="6dp" />

    <!-- The fact fills the space between the title and the button. maxLines keeps it
         from being clipped mid-word: it now ellipsises cleanly instead. The size is
         also adjusted at runtime to match how tall the user resized the widget. -->
    <TextView
        android:id="@+id/widget_fact_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_fact_placeholder"
        android:textSize="15sp"
        android:textColor="@color/widget_on_tertiary_container"
        android:lineSpacingMultiplier="1.15"
        android:gravity="center"
        android:maxLines="5"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_ask_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_ask_science_ai"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_tertiary_container"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:background="@drawable/bg_widget_chip" />

</LinearLayout>
