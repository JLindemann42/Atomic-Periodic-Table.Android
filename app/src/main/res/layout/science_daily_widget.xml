<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_science_daily_widget"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atomic - Daily Fact"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:alpha="0.8"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/widget_fact_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Did you know? Oxygen is the most abundant element in Earth's crust!"
        android:textSize="11sp"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:lineSpacingMultiplier="1.2"
        android:gravity="center"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_ask_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ask Science AI"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTertiary"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        android:background="@drawable/toast_outline" />

</LinearLayout>