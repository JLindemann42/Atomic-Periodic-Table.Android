<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tools_title_downstate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:paddingStart="@dimen/default_padding"
        android:paddingEnd="@dimen/default_padding"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:text="@string/tools"
        android:textColor="?attr/colorOnSurface"
        android:textSize="32sp"
        android:textStyle="normal" />

    <HorizontalScrollView
        android:id="@+id/most_used_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/mostT_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin_space_card"
                android:layout_marginEnd="@dimen/margin_space_card"
                android:layout_marginBottom="@dimen/margin_space_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="most_1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/toast_ripple"/>

            <TextView
                android:id="@+id/mostT_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_space_card"
                android:layout_marginEnd="@dimen/margin_space_card"
                android:layout_marginBottom="@dimen/margin_space_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="most_2"
                android:padding="@dimen/margin_space_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/toast_ripple"/>

            <TextView
                android:id="@+id/mostT_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_space_card"
                android:layout_marginEnd="@dimen/margin_space_card"
                android:layout_marginBottom="@dimen/margin_space_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="most_3"
                android:padding="@dimen/margin_space_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/toast_ripple"/>

            <TextView
                android:id="@+id/mostT_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_space_card"
                android:layout_marginEnd="@dimen/margin_space_card"
                android:layout_marginBottom="@dimen/margin_space_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:background="@drawable/toast"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="most_4"
                android:padding="@dimen/margin_space_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/toast_ripple"/>

        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
