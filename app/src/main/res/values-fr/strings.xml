    <string name="pro_features_descr">Découvrez certaines des nombreuses fonctionnalités de la version PRO et ce qu\'elles incluent.</string>
    <string name="pro_upgrade_to_pro">Passer à PRO</string>
    <string name="pro_additional_data">Données supplémentaires</string>
    <string name="pro_additional_data_descr">Données supplémentaires telles que les propriétés de dureté (dureté Mohs, Vickers et Brinell) ainsi que la vitesse du son, la constante de Poisson, les modules de Young, de compressibilité et de cisaillement, etc. Également des informations sur l\'identification des minéraux.</string>
    <string name="pro_additional_tables">Tableaux supplémentaires</string>
    <string name="pro_additional_tables_descr">Tableaux supplémentaires incluant un tableau des nucléides, un tableau du coefficient de Poisson, un tableau des constantes, un tableau de géologie, etc., avec d\'autres à venir</string>
    <string name="pro_better_calculator">Meilleure calculatrice</string>
    <string name="pro_better_calculator_descr">Une calculatrice améliorée avec la possibilité de sauvegarder les masses molaires de différents composés dans la page des favoris.</string>
    <string name="pro_additional_flashcards">Cartes mémoire supplémentaires et synchronisation</string>
    <string name="pro_additional_flashcards_descr">Accès à des cartes mémoire supplémentaires, plus de vies et synchronisation de vos progrès</string>
    <string name="pro_additional_visualisations">Visualisations supplémentaires</string>
    <string name="pro_additional_visualisations_descr">Accès à plus de visualisations dans le tableau principal telles que le coefficient de Poisson, le module de compressibilité, etc.</string>
