<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Mascot: Cute atom with face -->
    
    <!-- Nucleus -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 12,12 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />

    <!-- Electron orbits -->
    <path
        android:pathData="M 12,12 m -8,0 a 8,8 0 0,1 16,0 a 8,8 0 0,1 -16,0"
        android:strokeWidth="0.8"
        android:strokeColor="?attr/colorPrimary"
        android:fillColor="@android:color/transparent" />
    
    <path
        android:pathData="M 12,12 m -6,0 a 6,6 0 0,1 12,0 a 6,6 0 0,1 -12,0"
        android:strokeWidth="0.8"
        android:strokeColor="?attr/colorPrimary"
        android:fillColor="@android:color/transparent"
        android:rotation="60"
        android:pivotX="12"
        android:pivotY="12" />
    
    <!-- Electrons as small circles -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 20,12 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 4,12 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 12,20 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />
    
    <!-- Happy eyes -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 10,10 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />

    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M 14,10 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0" />

    <!-- Smile -->
    <path
        android:pathData="M 10,13 Q 12,15 14,13"
        android:strokeWidth="0.8"
        android:strokeColor="?attr/colorPrimary"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

</vector>
