<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined pill for widget buttons. Uses a literal colour rather than
     ?attr/actionMenuTextColor so it renders identically inside RemoteViews. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/transparent"/>
    <corners android:radius="18dp"/>
    <stroke android:width="1dp" android:color="@color/widget_on_tertiary_container"/>
</shape>
