<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:rowCount="2"
    android:padding="12dp">

    <!-- Periodic Table -->
    <LinearLayout
        android:id="@+id/nav_table"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_tile"
        android:backgroundTint="@android:color/system_accent2_100">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_grid"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Table"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_accent2_800"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Quiz -->
    <LinearLayout
        android:id="@+id/nav_quiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_tile"
        android:backgroundTint="@android:color/system_accent2_100">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_flashcards"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_accent2_800"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- AI -->
    <LinearLayout
        android:id="@+id/nav_ai"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_tile"
        android:backgroundTint="@android:color/system_accent2_100">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_ai_mascot"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_accent2_800"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Molar Mass -->
    <LinearLayout
        android:id="@+id/nav_molar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_tile"
        android:backgroundTint="@android:color/system_accent2_100">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_calculator"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Molar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_accent2_800"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</GridLayout>